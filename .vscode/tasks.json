{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Analytics",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["run", "build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Analytics (kill old server)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "$conn = Get-NetTCPConnection -LocalPort 8791 -ErrorAction SilentlyContinue | Select-Object -First 1; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force }; npm.cmd run build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
